---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/business';
import { getWhatsAppUrl } from '../lib/whatsapp';
---

<BaseLayout
  title={`Página não encontrada | ${business.shortName}`}
  description="Esta página não existe. Volte para o início ou fale com a Império Eletrônicos pelo WhatsApp."
  noindex
>
  <section class="section nf" id="inicio">
    <div class="container nf__inner">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1>Esta página não existe</h1>
      <p class="lead">O endereço pode ter mudado. A loja continua no mesmo lugar.</p>
      <div class="nf__actions">
        <a class="btn btn--primary btn--lg" href="/">Voltar para o início</a>
        <a class="btn btn--ghost btn--lg" href={getWhatsAppUrl(business.whatsapp.messages.home)} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          <span>Falar no WhatsApp</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf__inner {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    min-height: 50vh;
    align-content: center;
  }

  .nf__code {
    font-size: clamp(4rem, 3rem + 6vw, 7rem);
    font-stretch: 78%;
    font-weight: 820;
    line-height: 0.85;
    color: var(--steel);
  }

  h1 {
    font-size: var(--fs-h2);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
</style>
