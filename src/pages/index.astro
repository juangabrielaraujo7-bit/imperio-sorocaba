---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import BeforeAfterSection from '../components/BeforeAfterSection.astro';
import Brands from '../components/Brands.astro';
import QuoteForm from '../components/QuoteForm.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Reviews from '../components/Reviews.astro';
import StoreIntro from '../components/StoreIntro.astro';
import Location from '../components/Location.astro';
import Faq from '../components/Faq.astro';
import MinuteTrack from '../components/MinuteTrack.astro';
import { homeFaqs } from '../data/content';

const title = 'Assistência Técnica de Celular em Sorocaba | Império Eletrônicos';
const description =
  'Conserto de celular em Sorocaba: tela, bateria, conector de carga, tampa traseira e placa. iPhone, Samsung, Motorola e Xiaomi. Orçamento pelo WhatsApp.';
---

<BaseLayout title={title} description={description} splash>
  <Hero />
  <div class="container divider"><MinuteTrack class="reveal" /></div>
  <Services />
  <BeforeAfterSection />
  <Brands />
  <div class="container divider"><MinuteTrack class="reveal" /></div>
  <QuoteForm />
  <div class="container divider"><MinuteTrack class="reveal" /></div>
  <HowItWorks />
  <Reviews />
  <StoreIntro />
  <Location />
  <Faq faqs={homeFaqs} />
</BaseLayout>
