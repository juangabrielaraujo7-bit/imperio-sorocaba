---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MinuteTrack from '../components/MinuteTrack.astro';
import Services from '../components/Services.astro';
import Trust from '../components/Trust.astro';
import WorksAndStore from '../components/WorksAndStore.astro';
import Reviews from '../components/Reviews.astro';
import About from '../components/About.astro';
import Location from '../components/Location.astro';
import FinalCta from '../components/FinalCta.astro';
import { business } from '../data/business';

const title = 'Assistência Técnica de Celular em Sorocaba | Império Eletrônicos';
const description = `Conserto e manutenção de celular em Sorocaba, com loja física na ${business.address.neighborhood}. Nota ${business.reviews.rating.toFixed(1).replace('.', ',')} no Google. Fale pelo WhatsApp ${business.phone.display}.`;
---

<BaseLayout title={title} description={description} splash>
  <Hero />
  <div class="container"><MinuteTrack class="reveal" /></div>
  <Services />
  <Trust />
  <WorksAndStore />
  <Reviews />
  <About />
  <Location />
  <FinalCta />
</BaseLayout>
