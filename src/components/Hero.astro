---
import Icon from './Icon.astro';
import HeroCrown from './HeroCrown.astro';
import { business } from '../data/business';
import { heroMedia } from '../data/media';
import { getWhatsAppUrl } from '../lib/whatsapp';

---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero__grid-bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title">
        Seu celular quebrou? <span class="hero__accent">A Império Eletrônicos <span class="hero__bar">resolve.</span></span>
      </h1>
      <p class="lead hero__lead">Assistência técnica de celulares em {business.address.city}.</p>

      <div class="hero__actions">
        <a
          class="btn btn--primary btn--lg"
          href={getWhatsAppUrl(business.whatsapp.messages.home)}
          target="_blank"
          rel="noopener"
          data-wa="hero"
        >
          <Icon name="whatsapp" />
          <span>Orçamento no WhatsApp</span>
        </a>
        <a class="btn btn--ghost btn--lg" href="#servicos">
          <span>Ver serviços</span>
          <Icon name="arrow-right" />
        </a>
      </div>


    </div>

    <div class="hero__visual">
      {
        heroMedia ? (
          <figure class="hero__media">
            {heroMedia.type === 'video' ? (
              <video
                src={heroMedia.src}
                poster={heroMedia.poster}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={heroMedia.alt}
              />
            ) : heroMedia.type === 'image' ? (
              <img src={heroMedia.src} alt={heroMedia.alt} width={heroMedia.width ?? 800} height={heroMedia.height ?? 1000} fetchpriority="high" />
            ) : null}
          </figure>
        ) : (
          <HeroCrown />
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.25rem, 1rem + 5vw, 5.5rem) clamp(3.5rem, 2rem + 5vw, 6.5rem);
  }

  /* grade de bancada, fina e esmaecida */
  .hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(25 91 119 / 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(25 91 119 / 0.07) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: center top;
    -webkit-mask-image: radial-gradient(70% 80% at 75% 45%, #000 20%, transparent 75%);
    mask-image: radial-gradient(70% 80% at 75% 45%, #000 20%, transparent 75%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 1rem + 4vw, 4rem);
    align-items: center;
  }

  .hero__title {
    font-size: var(--fs-h1);
    font-stretch: 82%;
    font-weight: 820;
    line-height: 0.98;
    letter-spacing: -0.025em;
    word-spacing: 0.08em;
    max-width: 14ch;
  }

  .hero__accent {
    display: block;
    color: var(--steel);
  }

  .hero__bar {
    position: relative;
    white-space: nowrap;
  }

  /* barra dourada da logo sob "resolve" */
  .hero__bar::after {
    content: '';
    position: absolute;
    left: 0.02em;
    right: 0.02em;
    bottom: -0.06em;
    height: 0.12em;
    border-radius: 0.04em;
    background: var(--gold);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__bar::after {
      animation: bar-in 1s var(--ease-out) 0.35s both;
    }
  }

  @keyframes bar-in {
    from {
      transform: scaleX(0);
    }
  }

  .hero__lead {
    margin-top: 1.25rem;
    max-width: none;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__visual {
    width: min(100%, 21rem);
    justify-self: center;
  }

  .hero__media {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--enamel);
    box-shadow: var(--shadow-2);
  }

  .hero__media :is(img, video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 420px) {
    .hero__actions .btn {
      width: 100%;
    }
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .hero__visual {
      width: min(100%, 34rem);
      justify-self: end;
    }

    .hero__title {
      max-width: 21ch;
      font-size: clamp(3rem, 1.4rem + 2.9vw, 4rem);
    }
  }
</style>
