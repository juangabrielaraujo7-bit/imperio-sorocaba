---
/** Links internos no fim das páginas (outros serviços, marcas). */
import Icon from './Icon.astro';

interface Group {
  title: string;
  links: { label: string; href: string }[];
}

interface Props {
  groups: Group[];
}

const { groups } = Astro.props;
---

<nav class="links" aria-label="Páginas relacionadas">
  <div class="container links__inner">
    {
      groups.map((g) => (
        <div class="links__group">
          <h2 class="dial-label">{g.title}</h2>
          <ul role="list">
            {g.links.map((l) => (
              <li>
                <a href={l.href}>
                  {l.label}
                  <Icon name="arrow-right" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</nav>

<style>
  .links {
    padding-block: var(--section) clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .links__inner {
    display: grid;
    gap: 2rem;
  }

  .links h2 {
    color: var(--steel);
    margin-bottom: 0.75rem;
  }

  .links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .links a :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--steel);
    transition: transform 0.35s var(--ease-out);
  }

  .links a:hover {
    border-color: var(--steel);
    color: var(--steel);
  }

  .links a:hover :global(svg) {
    transform: translateX(3px);
  }

  @media (min-width: 900px) {
    .links__inner {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
