---
/**
 * Composição da hero sem fotos: um mostrador de esmalte (trilho de minutos,
 * índice dourado no 12, ponteiro em varredura) com um celular aberto em
 * três planos, como numa vista explodida de bancada.
 */
const C = 260;
const ticks = Array.from({ length: 60 }, (_, i) => {
  const idx = i;
  const major = i % 5 === 0;
  const a = (i * 6 * Math.PI) / 180;
  const r1 = major ? 214 : 226;
  const r2 = 238;
  return {
    major,
    x1: +(C + r1 * Math.sin(a)).toFixed(2),
    y1: +(C - r1 * Math.cos(a)).toFixed(2),
    x2: +(C + r2 * Math.sin(a)).toFixed(2),
    y2: +(C - r2 * Math.cos(a)).toFixed(2),
    skip: i === 0,
    i: idx,
  };
});
---

<div class="dial" aria-hidden="true">
  <svg class="dial__svg" viewBox="0 0 520 520" width="520" height="520" fill="none">
    <defs>
      <radialGradient id="enamel" cx="38%" cy="30%" r="80%">
        <stop offset="0" stop-color="#FFFFFF"></stop>
        <stop offset="0.65" stop-color="#F7F9FA"></stop>
        <stop offset="1" stop-color="#E9EFF2"></stop>
      </radialGradient>
      <clipPath id="screen-clip">
        <rect x="-62" y="-118" width="124" height="236" rx="16"></rect>
      </clipPath>
      <linearGradient id="gleam" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#FFFFFF" stop-opacity="0"></stop>
        <stop offset="0.5" stop-color="#FFFFFF" stop-opacity="0.9"></stop>
        <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"></stop>
      </linearGradient>
      <linearGradient id="glass" x1="0" y1="0" x2="0.6" y2="1">
        <stop offset="0" stop-color="#1D6584"></stop>
        <stop offset="1" stop-color="#0F4157"></stop>
      </linearGradient>
    </defs>

    <!-- mostrador -->
    <circle cx="260" cy="260" r="252" fill="url(#enamel)" stroke="#195B77" stroke-width="1.5"></circle>
    <circle cx="260" cy="260" r="244" stroke="#195B77" stroke-opacity="0.25"></circle>

    <!-- trilho de minutos -->
    <g class="dial__ticks" stroke="#195B77" stroke-linecap="round">
      {
        ticks.map(
          (t) =>
            !t.skip && (
              <line
                x1={t.x1}
                y1={t.y1}
                x2={t.x2}
                y2={t.y2}
                stroke-width={t.major ? 4 : 1.5}
                stroke-opacity={t.major ? 1 : 0.55}
                style={`--i:${t.i}`}
              />
            ),
        )
      }
    </g>

    <!-- índice dourado no 12: o losango da logo -->
    <circle class="dial__index" cx="260" cy="34" r="9" fill="#FDC528" stroke="#195B77" stroke-width="2.5"></circle>

    <!-- celular aberto em três planos -->
    <g class="dial__phone" transform="translate(260 270)">
      <!-- tampa traseira -->
      <g class="plane plane--back">
        <g transform="rotate(-16) translate(64 -10)">
          <rect x="-74" y="-140" width="148" height="280" rx="26" fill="#195B77"></rect>
          <rect x="-58" y="-124" width="52" height="80" rx="16" fill="#0F4157"></rect>
          <circle cx="-32" cy="-104" r="14" stroke="#FFFFFF" stroke-width="3"></circle>
          <circle cx="-32" cy="-64" r="14" stroke="#FFFFFF" stroke-width="3"></circle>
          <circle cx="0" cy="33" r="7" fill="#FDC528"></circle>
        </g>
      </g>

      <!-- interior: placa, bateria, contatos -->
      <g class="plane plane--mid">
        <g transform="rotate(-8) translate(28 -2)">
          <rect x="-74" y="-140" width="148" height="280" rx="26" fill="#EAF0F3" stroke="#195B77" stroke-width="2"></rect>
          <path d="M-58 -124 H58 V-40 H18 V-20 H-58 Z" fill="#FFFFFF" stroke="#195B77" stroke-width="2" stroke-linejoin="round"></path>
          <rect x="-58" y="-6" width="116" height="122" rx="10" fill="#FFFFFF" stroke="#195B77" stroke-width="2"></rect>
          <path d="M-36 40 H36 M-36 56 H16" stroke="#195B77" stroke-opacity="0.35" stroke-width="2" stroke-linecap="round"></path>
          <g fill="#FDC528" stroke="#195B77" stroke-width="1.25">
            <rect x="-46" y="-112" width="10" height="10" rx="2"></rect>
            <rect x="-30" y="-112" width="10" height="10" rx="2"></rect>
            <rect x="-14" y="-112" width="10" height="10" rx="2"></rect>
          </g>
          <rect x="16" y="-114" width="30" height="30" rx="5" fill="#195B77"></rect>
          <path d="M-46 -76 H4 M-46 -62 H-10" stroke="#195B77" stroke-opacity="0.35" stroke-width="2" stroke-linecap="round"></path>
        </g>
      </g>

      <!-- frente: vidro com reflexo -->
      <g class="plane plane--front">
        <g transform="rotate(-2) translate(-18 6)">
          <rect x="-74" y="-140" width="148" height="280" rx="26" fill="#FFFFFF" stroke="#195B77" stroke-width="3"></rect>
          <rect x="-62" y="-118" width="124" height="236" rx="16" fill="url(#glass)"></rect>
          <g clip-path="url(#screen-clip)">
            <path d="M-62 -118 L62 -118 L-62 30 Z" fill="#FFFFFF" fill-opacity="0.06"></path>
            <g transform="rotate(24)"><rect class="dial__gleam" x="-150" y="-160" width="60" height="320" fill="url(#gleam)" opacity="0.5"></rect></g>
          </g>
          <rect x="-16" y="-131" width="32" height="6" rx="3" fill="#195B77"></rect>
          <path d="M-12 128 H12" stroke="#195B77" stroke-width="3" stroke-linecap="round"></path>
        </g>
      </g>
    </g>

    <!-- ponteiro de segundos, centrado no mostrador, por cima do aparelho -->
    <g class="dial__hand">
      <line x1="260" y1="284" x2="260" y2="72" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round" stroke-opacity="0.9"></line>
      <line x1="260" y1="284" x2="260" y2="72" stroke="#195B77" stroke-width="2" stroke-linecap="round"></line>
      <circle cx="260" cy="66" r="7" fill="#FDC528" stroke="#195B77" stroke-width="1.5"></circle>
      <circle cx="260" cy="260" r="7" fill="#195B77" stroke="#FFFFFF" stroke-width="2"></circle>
      <circle cx="260" cy="260" r="2.2" fill="#FDC528"></circle>
    </g>
  </svg>
</div>

<style>
  .dial {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .dial__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 30px 40px rgb(15 65 87 / 0.14));
  }

  .dial__hand {
    transform-origin: 260px 260px;
    transform: rotate(var(--hand-start, 38deg));
  }

  .plane {
    transition: transform 1.2s var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .dial__hand {
      animation: sweep 60s linear infinite;
    }

    .plane--back {
      animation: drift-back 7s var(--ease-in-out) infinite alternate;
    }

    .plane--mid {
      animation: drift-mid 7s var(--ease-in-out) infinite alternate;
    }

    .dial__gleam {
      animation: gleam 6.5s var(--ease-in-out) 1.2s infinite;
    }

    .dial__ticks line {
      animation: tick-in 0.6s var(--ease-out) both;
      animation-delay: calc(var(--i) * 14ms + 150ms);
    }
  }

  @keyframes sweep {
    from {
      transform: rotate(var(--hand-start, 38deg));
    }
    to {
      transform: rotate(calc(var(--hand-start, 38deg) + 360deg));
    }
  }

  @keyframes drift-back {
    to {
      transform: translate(10px, -6px) rotate(-1.5deg);
    }
  }

  @keyframes drift-mid {
    to {
      transform: translate(5px, -3px) rotate(-0.75deg);
    }
  }

  @keyframes gleam {
    0%,
    55% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(320px);
    }
  }

  @keyframes tick-in {
    from {
      opacity: 0;
    }
  }
</style>
