---
/**
 * Trabalhos realizados (antes/depois) + Acessórios.
 *
 * Com fotos/produtos cadastrados em src/data/content.ts, cada bloco vira
 * uma galeria completa. Sem conteúdo, mostra uma versão mínima e discreta.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import BeforeAfter from './BeforeAfter.astro';
import { works, productCategories } from '../data/content';
import { business } from '../data/business';
import { getWhatsAppUrl } from '../lib/whatsapp';

const hasWorks = works.length > 0;
const hasProducts = productCategories.length > 0;
---

<div class:list={['ws', { 'ws--split': !hasWorks && !hasProducts }]}>
  <section class="section ws__block ws__works" id="trabalhos" aria-labelledby="trabalhos-title">
    <div class="container">
      {
        hasWorks ? (
          <>
            <div class="ws__head reveal">
              <h2 id="trabalhos-title">Trabalhos realizados</h2>
              <p class="lead">Aparelhos que passaram pela bancada da loja, antes e depois do serviço.</p>
            </div>
            <ul class="ws__gallery" role="list">
              {works.map((work, i) => (
                <li class="reveal" style={`--i:${i}`}>
                  <BeforeAfter work={work} />
                </li>
              ))}
            </ul>
          </>
        ) : (
          <div class="well reveal">
            <span class="well__frame" aria-hidden="true">
              <span class="well__half">Antes</span>
              <span class="well__seam" />
              <span class="well__half">Depois</span>
            </span>
            <div class="well__copy">
              <h2 id="trabalhos-title" class="well__title">Trabalhos realizados</h2>
              <p>Fotos de antes e depois dos aparelhos consertados na loja vão aparecer aqui. Enquanto isso, acompanhe a loja no Instagram.</p>
              <a class="arrow-link" href={business.instagram.url} target="_blank" rel="noopener">
                <Icon name="instagram" />
                <span>{business.instagram.handle}</span>
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section class="section ws__block ws__store" id="acessorios" aria-labelledby="acessorios-title">
    <div class="container">
      {
        hasProducts ? (
          <>
            <div class="ws__head reveal">
              <h2 id="acessorios-title">Mais que assistência técnica</h2>
              <p class="lead">Acessórios e eletrônicos à venda na loja.</p>
            </div>
            <ul class="ws__products" role="list">
              {productCategories.map((p, i) => (
                <li class="product reveal" style={`--i:${i}`}>
                  {p.image && (
                    <Image src={p.image} alt={p.title} widths={[320, 480, 640]} sizes="(min-width: 900px) 280px, 50vw" />
                  )}
                  <h3>{p.title}</h3>
                  {p.text && <p>{p.text}</p>}
                </li>
              ))}
            </ul>
            <a
              class="btn btn--primary"
              href={getWhatsAppUrl(business.whatsapp.messages.store)}
              target="_blank"
              rel="noopener"
              data-wa="acessorios"
            >
              <Icon name="whatsapp" />
              <span>Consultar disponibilidade</span>
            </a>
          </>
        ) : (
          <div class="well well--store reveal" style="--i:1">
            <div class="well__copy">
              <span class="diamond well__gem" aria-hidden="true" />
              <h2 id="acessorios-title" class="well__title">Mais que assistência técnica</h2>
              <p>Procurando acessório para o celular? Pergunte pelo WhatsApp o que está disponível na loja.</p>
              <a
                class="arrow-link"
                href={getWhatsAppUrl(business.whatsapp.messages.store)}
                target="_blank"
                rel="noopener"
                data-wa="acessorios"
              >
                <Icon name="whatsapp" />
                <span>Perguntar no WhatsApp</span>
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>
</div>

<style>
  .ws--split {
    display: grid;
    max-width: calc(var(--max) + 2 * var(--gutter));
    margin-inline: auto;
  }

  .ws--split .ws__block {
    padding-block: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .ws--split .ws__works {
    padding-top: var(--section);
  }

  .ws--split .ws__store {
    padding-bottom: var(--section);
  }

  @media (min-width: 900px) {
    .ws--split {
      grid-template-columns: 1fr 1fr;
      padding-block: var(--section);
    }

    .ws--split .ws__block {
      padding-block: 0;
    }

    .ws--split .ws__works .container {
      padding-right: calc(var(--gutter) / 2);
    }

    .ws--split .ws__store .container {
      padding-left: calc(var(--gutter) / 2);
    }
  }

  .ws__head {
    display: grid;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .ws__head h2 {
    font-size: var(--fs-h2);
  }

  .ws__gallery {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .ws__gallery {
      grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    }
  }

  .ws__products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .product {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--enamel);
  }

  .product img {
    border-radius: var(--radius-sm);
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: 0.9rem;
  }

  .product h3 {
    font-size: 1.1rem;
  }

  .product p {
    margin-top: 0.3rem;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  /* ---- versão mínima: poço vazio, desenhado, aguardando conteúdo ---- */

  .well {
    display: grid;
    gap: 1.5rem;
    height: 100%;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }

  .well__title {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  .well__copy {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .well__copy p {
    color: var(--ink-2);
    max-width: 44ch;
  }

  .well__copy .arrow-link svg:first-child {
    width: 1.2rem;
    height: 1.2rem;
  }

  .well__frame {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    height: 7.5rem;
    border-radius: var(--radius-sm);
    background: var(--enamel);
    overflow: hidden;
  }

  .well__half {
    display: grid;
    place-items: end start;
    padding: 0.75rem 0.9rem;
    font-size: var(--fs-label);
    font-stretch: 125%;
    font-weight: 620;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--steel);
    background-image: radial-gradient(rgb(25 91 119 / 0.18) 1px, transparent 1.2px);
    background-size: 12px 12px;
  }

  .well__half + .well__seam + .well__half {
    place-items: end end;
  }

  .well__seam {
    position: relative;
    width: 2px;
    background: var(--steel);
  }

  .well__seam::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.1rem;
    height: 1.1rem;
    background: var(--gold);
    -webkit-mask: var(--diamond-mask) center / contain no-repeat;
    mask: var(--diamond-mask) center / contain no-repeat;
    transform: translate(-50%, -50%);
  }

  .well__gem {
    font-size: 1.1rem;
  }

  .well--store {
    align-content: end;
    background: var(--enamel);
  }
</style>
