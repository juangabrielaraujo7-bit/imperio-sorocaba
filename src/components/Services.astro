---
/** Home > Serviços: um card por serviço, com "Ver detalhes" e WhatsApp. */
import Icon from './Icon.astro';
import Art from './Art.astro';
import { services } from '../data/services';
import { getWhatsAppUrl } from '../lib/whatsapp';
---

<section class="section services" id="servicos" aria-labelledby="servicos-title">
  <div class="container">
    <h2 id="servicos-title" class="services__title reveal">Serviços</h2>

    <ul class="services__list" role="list">
      {
        services.map((service, i) => (
          <li class="svc reveal" style={`--i:${i % 3}`}>
            <span class="svc__ticks" aria-hidden="true" />
            <div class="svc__art">
              {service.image ? (
                <img
                  class="cutout"
                  src={service.image.src}
                  alt={service.image.alt}
                  width={service.image.width}
                  height={service.image.height}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Art name={service.art} />
              )}
            </div>
            <div class="svc__body">
              <h3 class="svc__title">
                {service.page ? (
                  <a href={`/${service.slug}`} class="svc__link">
                    {service.title}
                  </a>
                ) : (
                  service.title
                )}
              </h3>
              <p class="svc__short">{service.short}</p>
              <div class="svc__actions">
                {service.page && (
                  <span class="svc__more" aria-hidden="true">
                    Ver detalhes
                    <Icon name="arrow-right" />
                  </span>
                )}
                <a
                  class="svc__wa"
                  href={getWhatsAppUrl(service.whatsappMessage)}
                  target="_blank"
                  rel="noopener"
                  data-wa={`servico-${service.key}`}
                >
                  <Icon name="whatsapp" />
                  <span>
                    WhatsApp<span class="sr-only">: orçamento de {service.title.toLowerCase()}</span>
                  </span>
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services__title {
    font-size: var(--fs-h2);
    margin-bottom: clamp(1.75rem, 1.25rem + 2vw, 2.75rem);
  }

  .services__list {
    display: grid;
    gap: 0.75rem;
  }

  .svc {
    position: relative;
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1rem 0.75rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    transition:
      border-color 0.4s var(--ease-out),
      box-shadow 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  /* trilho de minutos no topo: acende em dourado no hover */
  .svc__ticks {
    position: absolute;
    top: 0;
    left: 1.25rem;
    right: 1.25rem;
    height: 8px;
    background: repeating-linear-gradient(to right, rgb(25 91 119 / 0.3) 0 1px, transparent 1px 10px);
  }

  .svc__ticks::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to right, var(--gold-deep) 0 2px, transparent 2px 10px);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.7s var(--ease-out);
  }

  .svc__art {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    background: var(--enamel);
    padding: 0.35rem;
    position: relative;
    overflow: hidden;
  }

  .svc__art :global(.art),
  .cutout {
    transition: transform 0.6s var(--ease-out);
  }

  /* recorte com fundo transparente, contido no poço de esmalte */
  .cutout {
    position: absolute;
    inset: 0.4rem;
    width: calc(100% - 0.8rem);
    height: calc(100% - 0.8rem);
    object-fit: contain;
    filter: drop-shadow(0 10px 14px rgb(15 65 87 / 0.18));
  }

  .svc__title {
    font-size: 1.2rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .svc__link {
    color: inherit;
    text-decoration: none;
  }

  /* o card inteiro leva à página do serviço */
  .svc__link::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .svc__short {
    margin-top: 0.3rem;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .svc__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.1rem;
    margin-top: 0.4rem;
  }

  .svc__more,
  .svc__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    font-size: 0.95rem;
    font-weight: 650;
    text-decoration: none;
  }

  .svc__more {
    color: var(--steel);
  }

  .svc__more :global(svg) {
    width: 1rem;
    height: 1rem;
    transition: transform 0.35s var(--ease-out);
  }

  .svc__wa {
    position: relative;
    z-index: 1;
    color: var(--ink-2);
  }

  .svc__wa :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--steel);
  }

  .svc__wa:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .svc:hover,
  .svc:focus-within {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-2);
    transform: translateY(-2px);
  }

  .svc:hover .svc__ticks::after,
  .svc:focus-within .svc__ticks::after {
    clip-path: inset(0 0 0 0);
  }

  .svc:hover .svc__art :global(.art),
  .svc:hover .cutout {
    transform: scale(1.06) rotate(-3deg);
  }

  .svc:hover .svc__more :global(svg) {
    transform: translateX(3px);
  }

  .svc__link:focus-visible {
    outline: none;
  }

  .svc:has(.svc__link:focus-visible) {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }

  @media (min-width: 640px) {
    .services__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .services__list {
      grid-template-columns: repeat(3, 1fr);
    }

    .svc {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0.85rem;
      padding: 1rem 1rem 0.5rem;
    }

    .svc__art {
      aspect-ratio: 2 / 1;
      padding: 0.6rem 2rem;
    }

    .svc__title {
      font-size: 1.25rem;
    }
  }
</style>
