---
import Icon from './Icon.astro';
import MinuteTrack from './MinuteTrack.astro';
import { business } from '../data/business';
import { getWhatsAppUrl } from '../lib/whatsapp';
---

<section class="section final" aria-labelledby="final-title">
  <div class="container final__inner">
    <MinuteTrack class="reveal final__track" />
    <h2 id="final-title" class="final__title reveal">
      Seu celular precisa de assistência? <span>Fale com a Império Eletrônicos.</span>
    </h2>
    <div class="final__actions reveal" style="--i:1">
      <a
        class="btn btn--primary btn--lg final__cta"
        href={getWhatsAppUrl(business.whatsapp.messages.home)}
        target="_blank"
        rel="noopener"
        data-wa="cta-final"
      >
        <Icon name="whatsapp" />
        <span>Chamar no WhatsApp</span>
      </a>
      <a class="final__phone" href={`tel:+${business.phone.e164}`}>
        <Icon name="phone" />
        <span>{business.phone.display}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .final__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .final :global(.final__track) {
    width: min(100%, 34rem);
  }

  .final__title {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    font-size: clamp(2.2rem, 1.4rem + 3.6vw, 4.25rem);
    font-stretch: 82%;
    font-weight: 820;
    line-height: 1;
    max-width: 18ch;
  }

  .final__title span {
    display: block;
    margin-top: 0.12em;
    color: var(--steel);
  }

  .final__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2.25rem;
  }

  .final__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-weight: 650;
    font-size: 1.1rem;
    color: var(--ink);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .final__phone:hover {
    text-decoration: underline;
  }

  .final__phone svg {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--steel);
  }

  @media (max-width: 420px) {
    .final__cta {
      width: 100%;
    }
  }
</style>
