---
/**
 * Comparador antes/depois. Arraste (ou use as setas do teclado) para
 * revelar o "depois". As duas fotos devem ter a mesma proporção.
 */
import { Image } from 'astro:assets';
import type { WorkItem } from '../data/content';

interface Props {
  work: WorkItem;
}

const { work } = Astro.props;
const sizes = '(min-width: 768px) 420px, 100vw';
const widths = [360, 540, 720, 960];
---

<figure class="ba">
  <div class="ba__stage" data-ba style="--pos: 50%">
    <Image
      class="ba__img"
      src={work.after}
      alt={`Depois: ${work.service} em ${work.device}`}
      widths={widths}
      sizes={sizes}
    />
    <div class="ba__before">
      <Image
        class="ba__img"
        src={work.before}
        alt={`Antes: ${work.device} antes do serviço`}
        widths={widths}
        sizes={sizes}
      />
    </div>
    <span class="ba__tag ba__tag--before">Antes</span>
    <span class="ba__tag ba__tag--after">Depois</span>
    <span class="ba__handle" aria-hidden="true"></span>
    <input
      class="ba__range"
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label={`Comparar antes e depois: ${work.device}`}
    />
  </div>
  <figcaption class="ba__caption">
    <span class="ba__service">{work.service}</span>
    <span class="ba__device">{work.device}</span>
    {work.description && <p>{work.description}</p>}
  </figcaption>
</figure>

<style>
  .ba__stage {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--enamel);
  }

  .ba__stage :global(.ba__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ba__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: var(--white);
    transform: translateX(-1px);
    pointer-events: none;
  }

  .ba__handle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--gold);
    -webkit-mask: var(--diamond-mask) center / contain no-repeat;
    mask: var(--diamond-mask) center / contain no-repeat;
    transform: translate(-50%, -50%);
  }

  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .ba__stage:has(.ba__range:focus-visible) {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }

  .ba__tag {
    position: absolute;
    top: 0.75rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: rgb(11 17 22 / 0.7);
    color: var(--white);
    font-size: var(--fs-label);
    font-stretch: 125%;
    font-weight: 620;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .ba__tag--before {
    left: 0.75rem;
  }

  .ba__tag--after {
    right: 0.75rem;
  }

  .ba__caption {
    display: grid;
    gap: 0.2rem;
    margin-top: 0.9rem;
  }

  .ba__service {
    font-weight: 700;
    font-size: 1.1rem;
  }

  .ba__device {
    font-size: var(--fs-small);
    color: var(--steel);
    font-weight: 600;
  }

  .ba__caption p {
    margin-top: 0.3rem;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((stage) => {
    const range = stage.querySelector<HTMLInputElement>('input[type="range"]');
    range?.addEventListener('input', () => stage.style.setProperty('--pos', `${range.value}%`));
  });
</script>
