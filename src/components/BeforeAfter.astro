---
/**
 * Comparador antes/depois. Arraste (ou use as setas do teclado).
 * As duas fotos devem ter a mesma proporção.
 */
interface Props {
  before: string;
  after: string;
  alt: string;
}

const { before, after, alt } = Astro.props;
---

<div class="ba" data-ba style="--pos: 50%">
  <img class="ba__img" src={after} alt={`Depois: ${alt}`} loading="lazy" decoding="async" />
  <div class="ba__before">
    <img class="ba__img" src={before} alt={`Antes: ${alt}`} loading="lazy" decoding="async" />
  </div>
  <span class="ba__tag ba__tag--before" aria-hidden="true">Antes</span>
  <span class="ba__tag ba__tag--after" aria-hidden="true">Depois</span>
  <span class="ba__handle" aria-hidden="true"></span>
  <input class="ba__range" type="range" min="0" max="100" value="50" aria-label={`Comparar antes e depois: ${alt}`} />
</div>

<style>
  .ba {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--enamel);
  }

  .ba__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ba__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: var(--white);
    transform: translateX(-1px);
    pointer-events: none;
  }

  .ba__handle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2rem;
    height: 2rem;
    background: var(--gold);
    -webkit-mask: var(--diamond-mask) center / contain no-repeat;
    mask: var(--diamond-mask) center / contain no-repeat;
    transform: translate(-50%, -50%);
  }

  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .ba:has(.ba__range:focus-visible) {
    outline: 3px solid var(--gold);
    outline-offset: -3px;
  }

  .ba__tag {
    position: absolute;
    top: 0.6rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: rgb(11 17 22 / 0.7);
    color: var(--white);
    font-size: 0.68rem;
    font-stretch: 125%;
    font-weight: 620;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .ba__tag--before {
    left: 0.6rem;
  }

  .ba__tag--after {
    right: 0.6rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('input[type="range"]');
    range?.addEventListener('input', () => el.style.setProperty('--pos', `${range.value}%`));
  });
</script>
