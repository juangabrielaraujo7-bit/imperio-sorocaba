---
/**
 * Mostrador de 24 horas: o arco dourado é o horário de atendimento,
 * o ponteiro marca a hora atual em Sorocaba.
 */
import { business } from '../data/business';
import { toMinutes, formatHour } from '../lib/hours';

const weekday = business.hours.find((h) => h.opens && h.closes);
const opens = weekday?.opens ?? '10:00';
const closes = weekday?.closes ?? '19:00';

const C = 120;
const R = 96;
const angle = (min: number) => (min / 1440) * 2 * Math.PI;
const point = (min: number, r = R) => {
  const a = angle(min);
  return [+(C + r * Math.sin(a)).toFixed(2), +(C - r * Math.cos(a)).toFixed(2)];
};

const o = toMinutes(opens);
const c = toMinutes(closes);
const [x1, y1] = point(o);
const [x2, y2] = point(c);
const large = c - o > 720 ? 1 : 0;
const arc = `M${x1} ${y1} A${R} ${R} 0 ${large} 1 ${x2} ${y2}`;

const ticks = Array.from({ length: 24 }, (_, h) => {
  const major = h % 6 === 0;
  const [ax, ay] = point(h * 60, major ? 76 : 81);
  const [bx, by] = point(h * 60, 86);
  return { ax, ay, bx, by, major };
});

const numerals = [0, 6, 12, 18].map((h) => {
  const [x, y] = point(h * 60, 62);
  return { h, x, y };
});
---

<div class="hdial" data-hours-dial>
  <svg viewBox="0 0 240 240" width="240" height="240" fill="none" aria-hidden="true">
    <circle cx="120" cy="120" r="112" fill="#FFFFFF" fill-opacity="0.05" stroke="#FFFFFF" stroke-opacity="0.25"></circle>
    <circle cx="120" cy="120" r={R} stroke="#FFFFFF" stroke-opacity="0.14" stroke-width="10"></circle>
    <path class="hdial__arc" d={arc} stroke="#FDC528" stroke-width="10" stroke-linecap="round" pathLength="1"></path>
    <g stroke="#FFFFFF" stroke-linecap="round">
      {
        ticks.map((t) => (
          <line
            x1={t.ax}
            y1={t.ay}
            x2={t.bx}
            y2={t.by}
            stroke-width={t.major ? 2.5 : 1.25}
            stroke-opacity={t.major ? 0.9 : 0.45}
          />
        ))
      }
    </g>
    {
      numerals.map((n) => (
        <text x={n.x} y={n.y} class="hdial__num" text-anchor="middle" dominant-baseline="central">
          {n.h}
        </text>
      ))
    }
    <g class="hdial__hand">
      <line x1="120" y1="120" x2="120" y2="30" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"></line>
      <circle cx="120" cy="28" r="6" fill="#FDC528"></circle>
      <circle cx="120" cy="120" r="5" fill="#FFFFFF"></circle>
    </g>
  </svg>
  <div class="hdial__center">
    <span class="hdial__range">{formatHour(opens)}–{formatHour(closes)}</span>
    <span class="hdial__days">Seg. a sex.</span>
  </div>
</div>

<style>
  .hdial {
    position: relative;
    width: min(100%, 17rem);
    aspect-ratio: 1;
  }

  .hdial svg {
    width: 100%;
    height: 100%;
  }

  .hdial__num {
    fill: var(--on-steel-2);
    font-size: 11px;
    font-weight: 600;
    font-stretch: 110%;
    font-family: var(--font);
  }

  .hdial__hand {
    transform-origin: 120px 120px;
    transform: rotate(var(--hand, 0deg));
    opacity: 0;
    transition:
      opacity 0.6s var(--ease-out),
      transform 1.4s var(--ease-out);
  }

  .hdial.is-live .hdial__hand {
    opacity: 1;
  }

  .hdial__center {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    gap: 0.15rem;
    pointer-events: none;
  }

  .hdial__range {
    font-size: 1.3rem;
    font-stretch: 82%;
    font-weight: 780;
    color: var(--white);
    line-height: 1;
    transform: translateY(-1.4rem);
  }

  .hdial__days {
    font-size: 0.6rem;
    font-stretch: 125%;
    font-weight: 620;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    transform: translateY(-1.4rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js .reveal) .hdial__arc {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset 1.6s var(--ease-out) 0.2s;
    }

    :global(.js .reveal.is-visible) .hdial__arc {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  import { nowInStoreTime } from '../lib/hours';

  const dials = document.querySelectorAll<HTMLElement>('[data-hours-dial]');
  const set = () => {
    const { minutes } = nowInStoreTime();
    const deg = (minutes / 1440) * 360;
    dials.forEach((d) => {
      d.style.setProperty('--hand', `${deg}deg`);
      d.classList.add('is-live');
    });
  };
  set();
  setInterval(set, 60_000);
</script>
