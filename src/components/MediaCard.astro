---
/**
 * Card de mídia: foto, vídeo ou antes/depois (src/data/media.ts).
 * Sem mídia (item = null), vira uma moldura baixa e discreta:
 * "seam" (antes | depois, costura com losango) ou "video".
 */
import type { MediaItem } from '../data/media';
import VideoCard from './VideoCard.astro';
import BeforeAfter from './BeforeAfter.astro';

interface Props {
  item: MediaItem | null;
  /** Legenda (usada também na moldura vazia) */
  label?: string;
  placeholder?: 'seam' | 'video';
  /** Proporção do quadro. Padrão 4/5 (foto em pé). */
  ratio?: string;
  class?: string;
}

const { item, label, placeholder = 'seam', ratio = '4 / 5', class: className } = Astro.props;
// moldura vazia é baixa para não ocupar a tela inteira no celular
const frameRatio = item ? ratio : '16 / 9';
const caption = item?.caption ?? label;
---

<figure class:list={['mcard', { 'mcard--empty': !item }, className]} style={`--ratio: ${frameRatio}`}>
  <div class="mcard__frame">
    {
      !item ? (
        placeholder === 'seam' ? (
          <div class="mcard__empty mcard__empty--seam" aria-hidden="true">
            <span class="mcard__half">Antes</span>
            <span class="mcard__seam" />
            <span class="mcard__half mcard__half--end">Depois</span>
          </div>
        ) : (
          <div class="mcard__empty mcard__empty--video" aria-hidden="true">
            <span class="mcard__play" />
            <span class="mcard__soon">Vídeo em breve</span>
          </div>
        )
      ) : item.type === 'image' ? (
        <img
          src={item.src}
          alt={item.alt}
          width={item.width ?? 800}
          height={item.height ?? 1000}
          loading="lazy"
          decoding="async"
        />
      ) : item.type === 'video' ? (
        <VideoCard src={item.src} poster={item.poster} alt={item.alt} />
      ) : (
        <BeforeAfter before={item.before} after={item.after} alt={item.alt} />
      )
    }
  </div>
  {
    caption && (
      <figcaption class="mcard__caption">
        <span class="diamond" aria-hidden="true" />
        <span>{caption}</span>
        {item?.type === 'before-after' && item.device && <span class="mcard__device">{item.device}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .mcard {
    display: grid;
    gap: 0.7rem;
    min-width: 0;
  }

  .mcard__frame {
    position: relative;
    aspect-ratio: var(--ratio);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--enamel);
    border: 1px solid var(--line);
  }

  .mcard__frame > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .mcard:hover .mcard__frame > img {
    transform: scale(1.03);
  }

  .mcard__empty {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(25 91 119 / 0.14) 1px, transparent 1.2px);
    background-size: 12px 12px;
  }

  .mcard__empty--seam {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
  }

  .mcard__half {
    display: grid;
    place-items: end start;
    padding: 0.7rem 0.85rem;
    font-size: var(--fs-label);
    font-stretch: 125%;
    font-weight: 620;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .mcard__half--end {
    place-items: end end;
  }

  .mcard__seam {
    position: relative;
    width: 2px;
    background: var(--steel);
  }

  .mcard__seam::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.1rem;
    height: 1.1rem;
    background: var(--gold);
    -webkit-mask: var(--diamond-mask) center / contain no-repeat;
    mask: var(--diamond-mask) center / contain no-repeat;
    transform: translate(-50%, -50%);
    transition: transform 0.6s var(--ease-out);
  }

  .mcard:hover .mcard__seam::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .mcard__empty--video {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
  }

  .mcard__play {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1.5px solid var(--steel);
    background: var(--white) url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 24 24%27%3E%3Cpath d=%27M9 6.5v11l8.5-5.5z%27 fill=%27%23195B77%27/%3E%3C/svg%3E") center / 1.2rem no-repeat;
  }

  .mcard__soon {
    font-size: 0.68rem;
    font-stretch: 125%;
    font-weight: 620;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .mcard__caption {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
    font-size: 1rem;
  }

  .mcard__caption .diamond {
    font-size: 0.75rem;
  }

  .mcard__device {
    margin-left: auto;
    font-size: var(--fs-small);
    font-weight: 560;
    color: var(--steel);
  }
</style>
