---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import { business } from '../data/business';
import { about } from '../data/content';

const { address } = business;
const hours = business.hoursSummary.find((h) => h.time !== 'Fechado');
const facts = [
  { term: 'Empresa', value: business.name },
  { term: 'Loja física', value: `${address.street}, ${address.complement}, ${address.neighborhood}` },
  { term: 'Cidade', value: `${address.city} - ${address.state}` },
  { term: 'Atendimento', value: hours ? `${hours.days.toLowerCase()}, das ${hours.time}` : '' },
];
---

<section class="section about" id="sobre" aria-labelledby="sobre-title">
  <div class="container about__inner">
    <div class="about__media reveal">
      {
        about.photo ? (
          <Image
            src={about.photo}
            alt={about.photoAlt}
            widths={[480, 720, 960]}
            sizes="(min-width: 900px) 40vw, 100vw"
            class="about__photo"
          />
        ) : (
          <div class="about__plate" aria-hidden="true">
            <Logo wordmark={false} class="about__mark" />
          </div>
        )
      }
    </div>

    <div class="about__copy">
      <h2 id="sobre-title" class="about__title reveal">Sobre a Império</h2>
      {
        about.story.length > 0 && (
          <div class="about__story reveal">
            {about.story.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        )
      }
      <dl class="about__facts">
        {
          facts.map((f, i) => (
            <div class="about__fact reveal" style={`--i:${i}`}>
              <dt class="dial-label">{f.term}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    align-items: center;
  }

  .about__title {
    font-size: var(--fs-h2);
  }

  .about__story {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    max-width: 60ch;
    color: var(--ink-2);
  }

  .about__facts {
    margin-top: 2rem;
    border-top: 1px solid var(--line-strong);
  }

  .about__fact {
    display: grid;
    gap: 0.35rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .about__fact dt {
    color: var(--steel);
  }

  .about__fact dd {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .about__photo {
    width: 100%;
    border-radius: var(--radius);
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* placa de esmalte com a coroa, até chegar a foto real da loja */
  .about__plate {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 4;
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 50% 46%, var(--white) 0 38%, transparent 38.2%),
      var(--enamel);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .about__plate::before {
    content: '';
    position: absolute;
    width: 76%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      repeating-conic-gradient(from -0.6deg, rgb(25 91 119 / 0.55) 0 1.2deg, transparent 1.2deg 6deg);
    -webkit-mask: radial-gradient(circle, transparent 62%, #000 62.5% 66%, transparent 66.5%);
    mask: radial-gradient(circle, transparent 62%, #000 62.5% 66%, transparent 66.5%);
  }

  .about__plate :global(.about__mark .logo__mark) {
    position: relative;
    width: clamp(7rem, 5rem + 8vw, 11rem);
  }

  @media (min-width: 900px) {
    .about__inner {
      grid-template-columns: 0.9fr 1.1fr;
    }

    .about__fact {
      grid-template-columns: 10rem 1fr;
      align-items: baseline;
    }
  }
</style>
