---
/** Home > Como funciona: 4 etapas sobre um trilho de minutos. */
import { steps } from '../data/content';
---

<section class="section how" id="como-funciona" aria-labelledby="como-title">
  <div class="container">
    <h2 id="como-title" class="how__title reveal">Como funciona</h2>
    <ol class="how__list" role="list">
      {
        steps.map((step, i) => (
          <li class="how__step reveal" style={`--i:${i}`}>
            <span class="how__n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="diamond how__gem" aria-hidden="true" />
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how__title {
    font-size: var(--fs-h2);
    margin-bottom: clamp(1.75rem, 1.25rem + 2vw, 3rem);
  }

  .how__list {
    position: relative;
    display: grid;
    gap: 1.75rem;
    padding-left: 2rem;
  }

  /* trilho vertical no celular */
  .how__list::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 10px;
    background: repeating-linear-gradient(to bottom, rgb(25 91 119 / 0.4) 0 1px, transparent 1px 10px);
  }

  .how__step {
    position: relative;
    display: grid;
    gap: 0.2rem;
  }

  .how__gem {
    position: absolute;
    left: -2rem;
    top: 0.2rem;
    font-size: 1.15rem;
    transform: translateX(0.18rem);
  }

  .how__n {
    font-size: 0.8rem;
    font-stretch: 125%;
    font-weight: 650;
    letter-spacing: 0.14em;
    color: var(--steel);
    font-variant-numeric: tabular-nums;
  }

  .how__step h3 {
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
  }

  .how__step p {
    color: var(--ink-2);
    font-size: var(--fs-small);
  }

  @media (min-width: 900px) {
    .how__list {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
      padding-left: 0;
      padding-top: 2.25rem;
    }

    /* trilho horizontal no desktop */
    .how__list::before {
      left: 0;
      right: 0;
      top: 0;
      bottom: auto;
      width: auto;
      height: 12px;
      background:
        repeating-linear-gradient(to right, rgb(25 91 119 / 0.85) 0 2px, transparent 2px 60px) left top / 100% 12px no-repeat,
        repeating-linear-gradient(to right, rgb(25 91 119 / 0.35) 0 1px, transparent 1px 12px) left top / 100% 7px no-repeat;
    }

    .how__gem {
      left: 0;
      top: -2.85rem;
      transform: none;
      font-size: 1.3rem;
    }

    .how__step {
      padding-top: 0.25rem;
    }
  }
</style>
